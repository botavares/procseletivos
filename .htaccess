<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /servicos/procseletivos/
    
    # Regra explicita para /adm/ - redirecionar para public/index.php
    RewriteRule ^adm/?$ public/index.php?/adm/ [L,QSA]
    RewriteRule ^adm/(.*)$ public/index.php?/adm/$1 [L,QSA]
    
    # Redirecionar tudo para public/ (exceto se ja estiver em public/)
    RewriteCond %{REQUEST_URI} !^/servicos/procseletivos/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Desabilitar listagem de diretórios
Options -Indexes

# Proteger arquivos sensíveis
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>
